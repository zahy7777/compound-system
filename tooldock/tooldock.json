{
  "version": 1,
  "name": "Compound · 个人复利",
  "description": "事实与标签森林，网页和快捷桌面共用一套业务",
  "category": "个人工具",
  "icon": "assets/icon.png",
  "services": [
    {
      "id": "dev-backend",
      "name": "dev · Compound 服务",
      "kind": "atomic",
      "location": "local",
      "access": {
        "type": "web"
      },
      "scripts": {
        "start": "scripts/backend/dev-start.ps1",
        "stop": "scripts/backend/dev-stop.ps1",
        "status": "scripts/backend/dev-status.ps1",
        "build": "scripts/runtime/build.ps1"
      },
      "startTimeoutMs": 30000
    },
    {
      "id": "dev-desktop",
      "name": "dev · 快捷桌面",
      "kind": "atomic",
      "location": "local",
      "access": {
        "type": "desktop"
      },
      "scripts": {
        "start": "scripts/desktop/dev-start.ps1",
        "stop": "scripts/desktop/dev-stop.ps1",
        "status": "scripts/desktop/dev-status.ps1",
        "build": "scripts/runtime/build.ps1"
      },
      "startTimeoutMs": 30000
    },
    {
      "id": "dev",
      "name": "启动 dev",
      "kind": "composite",
      "members": [
        "dev-backend",
        "dev-desktop"
      ],
      "openService": "dev-backend"
    },
    {
      "id": "dev-rebuild",
      "name": "重新构建并运行 dev",
      "kind": "composite",
      "members": [
        "dev-backend",
        "dev-desktop"
      ],
      "openService": "dev-backend",
      "rebuild": true
    },
    {
      "id": "prod-backend",
      "name": "prod · Compound 服务",
      "kind": "atomic",
      "location": "local",
      "access": {
        "type": "web"
      },
      "scripts": {
        "start": "scripts/backend/prod-start.ps1",
        "stop": "scripts/backend/prod-stop.ps1",
        "status": "scripts/backend/prod-status.ps1",
        "build": "scripts/runtime/build.ps1"
      },
      "startTimeoutMs": 30000
    },
    {
      "id": "prod-desktop",
      "name": "prod · 快捷桌面",
      "kind": "atomic",
      "location": "local",
      "access": {
        "type": "desktop"
      },
      "scripts": {
        "start": "scripts/desktop/prod-start.ps1",
        "stop": "scripts/desktop/prod-stop.ps1",
        "status": "scripts/desktop/prod-status.ps1",
        "build": "scripts/runtime/build.ps1"
      },
      "startTimeoutMs": 30000
    },
    {
      "id": "prod",
      "name": "启动 prod",
      "kind": "composite",
      "members": [
        "prod-backend",
        "prod-desktop"
      ],
      "openService": "prod-backend"
    },
    {
      "id": "prod-rebuild",
      "name": "重新构建并运行 prod",
      "kind": "composite",
      "members": [
        "prod-backend",
        "prod-desktop"
      ],
      "openService": "prod-backend",
      "rebuild": true
    }
  ]
}
